# Copie para .env e ajuste conforme a máquina.
# No lab, o banco PostgreSQL roda no DB01 (10.10.10.20).

# Identifica o papel da instância (aparece na página): APP01 ou WEB01
APP_ROLE=APP01

# Segurança / Django
DJANGO_SECRET_KEY=troque-esta-chave-no-lab
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Necessário quando a página é publicada via DNAT em outra porta (ex.: FW01:8080)
DJANGO_CSRF_TRUSTED_ORIGINS=http://203.0.113.1:8080,http://172.16.20.10

# Conexão com o PostgreSQL (DB01)
DB_NAME=labdb
DB_USER=labuser
DB_PASSWORD=labpass
DB_HOST=10.10.10.20
DB_PORT=5432
